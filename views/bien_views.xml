<odoo>
    <record id="view_immo_bien_list" model="ir.ui.view">
        <field name="name">immo.bien.list</field>
        <field name="model">immo.bien</field>
        <field name="arch" type="xml">
            <list>
                <field name="reference"/>
                <field name="name"/>
                <field name="surface"/>
                <field name="prix_demande"/>
                <field name="prix_vente"/>
                <field name="etat"
                    decoration-success="etat == 'vendu'"
                    decoration-info="etat == 'offre'"/>
            </list>
        </field>
    </record>

    <record id="action_immo_bien" model="ir.actions.act_window">
        <field name="name">Biens</field>
        <field name="res_model">immo.bien</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_immo_root" name="Immobilier" />
    <menuitem id="menu_immo_bien" name="Biens"
              parent="menu_immo_root" action="action_immo_bien"/>
</odoo>